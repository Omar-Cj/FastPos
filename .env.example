DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# MySQL (run scripts/mysql_setup.sql once). Leave unset to use SQLite for quick local runs.
DATABASE_URL=mysql://fastpos:fastpos@127.0.0.1:3306/fastpos
TIME_ZONE=Africa/Mogadishu
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Celery: eager=true runs tasks inline (no Redis needed)
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0

# Payments: mock | live
PAYMENT_PROVIDER_BACKEND=mock
PAYMENT_MOCK_OUTCOME=success
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
EDAHAB_API_KEY=
EDAHAB_AGENT_CODE=
EDAHAB_SECRET=
