DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# MySQL. Leave unset to use SQLite for quick local runs. Format: mysql://USER:PASSWORD@HOST:PORT/DB
# Either run scripts/mysql_setup.sql once (creates user fastpos/fastpos) or use your root login.
# Use the port from `port =` in /etc/mysql/mysql.conf.d/mysqld.cnf (3306 by default; some installs differ).
# Then load the time zone tables once (see README > MySQL) or per-day reports return NULL dates.
DATABASE_URL=mysql://fastpos:fastpos@127.0.0.1:3306/fastpos
TIME_ZONE=Africa/Mogadishu
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Celery: eager=true runs tasks inline (no Redis needed)
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0

# Payments: mock | live
PAYMENT_PROVIDER_BACKEND=mock
PAYMENT_MOCK_OUTCOME=success
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
EDAHAB_API_KEY=
EDAHAB_AGENT_CODE=
EDAHAB_SECRET=
